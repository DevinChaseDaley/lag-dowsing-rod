PORT=4000
HOST=0.0.0.0

# Leave FLY_API_TOKEN unset for local dev: the control-plane falls back to
# routing every region to the locally running game server (localhost:3001).
FLY_API_TOKEN=
FLY_APP_PREFIX=lag-dowsing-rod
FLY_ORG_SLUG=personal
# Not FLY_IMAGE_REF -- Fly auto-injects that name into every machine's own
# env, which would shadow this secret.
GAME_SERVER_IMAGE_REF=registry.fly.io/lag-dowsing-rod:latest
