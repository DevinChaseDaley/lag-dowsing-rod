# Base URL of the game/session server (Fastify + WebSocket). Defaults to
# http://localhost:3001 if unset.
VITE_API_URL=http://localhost:3001

# Comma-separated STUN server URLs used for WebRTC peer-to-peer connection
# negotiation (NAT traversal address discovery only — no ping or game data
# passes through them). Defaults to public Google STUN servers if unset.
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
